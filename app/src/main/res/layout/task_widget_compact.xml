<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:paddingHorizontal="10dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:text="@string/app_name"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_clock_region"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="30sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp"
            android:fontFamily="@font/fredoka_600"
            android:textColor="@color/widget_ink"
            android:textSize="56sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextClock
            android:id="@+id/widget_clock_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="5dp"
            android:format12Hour="a"
            android:format24Hour="@string/widget_clock_period_24"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_date_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="19sp"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_800"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/nunito_600"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_miyu"
            android:layout_width="60dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <LinearLayout android:id="@+id/widget_row_1" style="@style/TaskWidgetPrimaryRow" android:visibility="gone">
        <ImageView android:id="@+id/widget_marker_1" style="@style/TaskWidgetMarker" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout style="@style/TaskWidgetTextColumn">
            <TextView android:id="@+id/widget_title_1" style="@style/TaskWidgetTitle" />
            <TextView android:id="@+id/widget_meta_1" style="@style/TaskWidgetMeta" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" style="@style/TaskWidgetRow" android:visibility="gone">
        <ImageView android:id="@+id/widget_marker_2" style="@style/TaskWidgetMarker" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout style="@style/TaskWidgetTextColumn">
            <TextView android:id="@+id/widget_title_2" style="@style/TaskWidgetSecondaryTitle" />
            <TextView android:id="@+id/widget_meta_2" style="@style/TaskWidgetMeta" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" style="@style/TaskWidgetRow" android:visibility="gone">
        <ImageView android:id="@+id/widget_marker_3" style="@style/TaskWidgetMarker" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout style="@style/TaskWidgetTextColumn">
            <TextView android:id="@+id/widget_title_3" style="@style/TaskWidgetSecondaryTitle" />
            <TextView android:id="@+id/widget_meta_3" style="@style/TaskWidgetMeta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
